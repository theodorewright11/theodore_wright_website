---
const navLinks = [
  { href: '/research', label: 'My Research' },
  { href: '/ai-research', label: "AI’s Research" },
  { href: '/models', label: 'Models' },
  { href: '/dashboards', label: 'Dashboards' },
  { href: '/writing', label: 'Writing' },
  { href: '/updates', label: 'Updates' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="border-b border-rule bg-paper">
  <nav class="max-w-[1080px] mx-auto px-8 py-5 flex items-baseline justify-between gap-6 flex-wrap">
    <a
      href="/"
      class="font-display font-semibold text-[22px] text-ink no-underline hover:text-accent transition-colors"
      style="letter-spacing: -0.02em"
    >
      Teddy Wright
    </a>
    <div class="flex items-baseline gap-[18px] flex-wrap">
      {navLinks.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <a
            href={href}
            class:list={[
              'font-serif text-sm transition-colors',
              active
                ? 'italic text-accent underline underline-offset-4 decoration-1'
                : 'text-ink-soft no-underline hover:text-accent',
            ]}
          >
            {label}
          </a>
        );
      })}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch color theme"
        class="self-center font-mono text-[10px] uppercase text-muted hover:text-accent border border-rule hover:border-accent rounded-sm px-2 py-1 flex items-center gap-1.5 transition-colors"
        style="letter-spacing: 0.08em"
      >
        <span id="theme-swatch" class="inline-block w-2.5 h-2.5 rounded-full border border-rule"></span>
        <span id="theme-name">paper</span>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var THEMES = ['paper', 'white', 'dark', 'monokai'];
    // Swatch previews each palette's base background.
    var SWATCH = { paper: '#efe9dd', white: '#ffffff', dark: '#1b1917', monokai: '#2d2a2e' };
    function current() {
      return document.documentElement.getAttribute('data-theme') || 'paper';
    }
    function render(t) {
      var n = document.getElementById('theme-name');
      var s = document.getElementById('theme-swatch');
      if (n) n.textContent = t;
      if (s) s.style.background = SWATCH[t] || SWATCH.paper;
    }
    function set(t) {
      if (t === 'paper') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', t);
      try { localStorage.setItem('tw-theme', t); } catch (e) {}
      render(t);
    }
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function () {
        var i = THEMES.indexOf(current());
        set(THEMES[(i + 1) % THEMES.length]);
      });
    }
    render(current());
  })();
</script>
