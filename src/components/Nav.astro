---
// Three top-level tabs. "Lab" is the umbrella for AI's Research / Models /
// Dashboards — those keep their own URLs and get a sub-nav (LabNav) instead of
// each occupying a top-level slot.
const navLinks = [
  { href: '/research', label: 'Research', match: ['/research'] },
  { href: '/writing', label: 'Writing', match: ['/writing'] },
  { href: '/lab', label: 'Lab', match: ['/lab', '/ai-research', '/models', '/dashboards'] },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (match: string[]) =>
  match.some(m => currentPath === m || currentPath.startsWith(`${m}/`));
---

<header class="border-b border-rule bg-paper">
  <nav class="max-w-[1080px] mx-auto px-8 py-5 flex items-baseline justify-between gap-6 flex-wrap">
    <a
      href="/"
      class="font-display font-semibold text-[22px] text-ink no-underline hover:text-accent transition-colors"
      style="letter-spacing: -0.02em"
    >
      Teddy Wright
    </a>
    <div class="flex items-baseline gap-[22px] flex-wrap">
      {navLinks.map(({ href, label, match }) => {
        const active = isActive(match);
        return (
          <a
            href={href}
            class:list={[
              'font-serif text-[15px] transition-colors',
              active
                ? 'italic text-accent underline underline-offset-4 decoration-1'
                : 'text-ink-soft no-underline hover:text-accent',
            ]}
          >
            {label}
          </a>
        );
      })}
    </div>
  </nav>
</header>
