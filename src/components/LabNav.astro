---
// Sub-nav for the Lab section. Rendered by BaseLayout on any /lab, /ai-research,
// /models or /dashboards page.
const links = [
  { href: '/lab', label: 'Overview', exact: true },
  { href: '/ai-research', label: 'AI’s Research' },
  { href: '/models', label: 'Models' },
  { href: '/dashboards', label: 'Dashboards' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<div class="border-b border-rule-soft bg-paper-edge/40">
  <nav class="max-w-[1080px] mx-auto px-8 py-2.5 flex items-baseline gap-5 flex-wrap
              font-mono text-[11px] uppercase" style="letter-spacing: 0.1em">
    {links.map(({ href, label, exact }) => {
      const active = exact
        ? currentPath === href
        : currentPath === href || currentPath.startsWith(`${href}/`);
      return (
        <a
          href={href}
          class:list={[
            'no-underline transition-colors',
            active ? 'text-accent' : 'text-muted hover:text-accent',
          ]}
        >
          {label}
        </a>
      );
    })}
  </nav>
</div>
