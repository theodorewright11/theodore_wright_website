---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import bio from '../data/bio.json';
import meImg from '../assets/pic_of_me.png';

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const writing = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const research = (await getCollection('research'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const other = [
  { href: '/dashboards', label: 'Dashboards', desc: 'Tools for different use cases — tracking spending, logging time, coding qualitative data.' },
  { href: '/models', label: 'Models', desc: 'Breakdowns of something into its parts, and how those parts interact.' },
  { href: '/ai-research', label: 'AI’s Research', desc: 'Topics researched by an LLM in six stages: lit review, topology, model, data, build, writeup.' },
];
---

<BaseLayout title="Teddy Wright">
  <div class="max-w-[1080px] mx-auto px-8 pt-12 pb-20">

    {/* Masthead */}
    <div class="border-b border-rule pb-9 mb-10">
      <h1 class="font-display font-semibold text-[60px] sm:text-[76px] text-ink leading-[0.92] m-0 whitespace-nowrap"
          style="letter-spacing: -0.035em">
        Teddy Wright
      </h1>
      <div class="max-w-[760px]">
        <div class="flex items-center gap-5 mt-6">
          <Image src={meImg} alt="Teddy Wright"
                 width={224} height={224} densities={[1, 2]} format="webp" quality={82}
                 class="w-24 h-24 sm:w-28 sm:h-28 object-cover border border-rule rounded-sm flex-shrink-0" />
          <p class="font-serif italic text-[13px] text-muted leading-[1.55] m-0"
             style="text-wrap: pretty">{bio.credentials}</p>
        </div>
        <p class="font-serif text-base leading-[1.6] text-ink-soft m-0 mt-6"
           style="text-wrap: pretty">{bio.blurb}</p>
        <div class="font-mono text-[11px] uppercase text-muted mt-4"
             style="letter-spacing: 0.08em">
          <a href={bio.linkedin} target="_blank" rel="noopener" class="text-ink no-underline hover:text-accent transition-colors">linkedin</a>
          <span class="text-muted"> / </span>
          <a href={bio.github} target="_blank" rel="noopener" class="text-ink no-underline hover:text-accent transition-colors">github</a>
          <span class="text-muted"> / </span>
          <a href={bio.substack} target="_blank" rel="noopener" class="text-ink no-underline hover:text-accent transition-colors">substack</a>
          <span class="text-muted"> / </span>
          <a href={`mailto:${bio.email}`} class="text-ink no-underline hover:text-accent transition-colors">email</a>
        </div>
      </div>
    </div>

    {/* Index — same order as the nav */}
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-14 items-start">

      <div>
        <SectionLabel label="Research" href="/research" />
        {research.slice(0, 4).map(r => (
          <article class="py-3">
            <h3 class="font-serif text-[16px] font-semibold m-0 text-ink leading-[1.35]">
              <a href={`/research/${r.slug}`}
                 class="text-ink no-underline hover:text-accent transition-colors">
                {r.data.title}
              </a>
            </h3>
          </article>
        ))}

        <div class="mt-11">
          <SectionLabel label="Writing" href="/writing" />
          {writing.slice(0, 4).map(p => (
            <article class="py-3">
              <div class="font-mono text-[10px] text-muted mb-1" style="letter-spacing: 0.1em">
                {fmt(p.data.date)}
              </div>
              <h3 class="font-serif text-[16px] font-semibold m-0 text-ink leading-[1.35]">
                <a href={`/writing/${p.slug}`}
                   class="text-ink no-underline hover:text-accent transition-colors">
                  {p.data.title}
                </a>
              </h3>
            </article>
          ))}
        </div>
      </div>

      <div>
        <SectionLabel label="Other" href="/other" />
        {other.map(l => (
          <article class="py-3.5">
            <h3 class="font-serif text-[16px] font-semibold m-0 mb-1 text-ink leading-[1.35]">
              <a href={l.href} class="text-ink no-underline hover:text-accent transition-colors">
                {l.label}
              </a>
            </h3>
            <p class="font-serif text-[14px] text-muted leading-[1.5] m-0"
               style="text-wrap: pretty">{l.desc}</p>
          </article>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
