---
import BaseLayout from '../layouts/BaseLayout.astro';
import GroupHeader from '../components/GroupHeader.astro';
import { getCollection } from 'astro:content';
import dashboards from '../data/dashboards.json';
import { pages, siteName, otherSections } from '../data/site';

const aiAll = await getCollection('ai_research');
const topics = new Map<string, string>();
for (const entry of aiAll) {
  const [topic, stage] = entry.slug.split('/');
  if (!topic) continue;
  if (stage === 'overview') topics.set(topic, entry.data.title);
  else if (!topics.has(topic)) topics.set(topic, topic);
}

const models = (await getCollection('models'))
  .filter(m => m.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Labels and descriptions come from `otherSections` in site.ts (shared with the
// home page); only the item lists are built here.
const itemsByHref: Record<string, { href: string; title: string }[]> = {
  '/dashboards': dashboards
    .filter(d => d.status === 'built')
    .map(d => ({ href: `/dashboards/${d.slug}`, title: d.title })),
  '/models': models.map(m => ({ href: `/models/${m.slug}`, title: m.data.title })),
  '/ai-research': Array.from(topics.entries()).map(([slug, title]) => ({
    href: `/ai-research/${slug}`, title,
  })),
};

const sections = otherSections.map(s => ({ ...s, items: itemsByHref[s.href] ?? [] }));
---

<BaseLayout title={`${pages.other.title} — ${siteName}`} description={pages.other.blurb}>
  <section class="max-w-[760px] mx-auto px-8 pt-14 pb-24">
    <h1 class="font-display font-semibold text-[48px] leading-none m-0 mb-3 text-ink"
        style="letter-spacing: -0.03em">{pages.other.title}</h1>
    <p class="font-serif text-[17px] text-muted leading-[1.55] max-w-[580px] m-0 mb-14">{pages.other.blurb}</p>

    {sections.map(s => (
      <section class="mb-14">
        <GroupHeader label={s.label} href={s.href} count={s.items.length} />
        <p class="font-serif text-[15px] text-ink-soft leading-[1.55] mt-3 mb-4"
           style="text-wrap: pretty">{s.desc}</p>
        <ul class="list-none p-0 m-0">
          {s.items.map((it, i) => (
            <li class:list={['py-2.5', i > 0 ? 'border-t border-rule-soft' : '']}>
              <a href={it.href}
                 class="font-serif text-[15px] font-semibold text-ink no-underline hover:text-accent transition-colors">
                {it.title}
              </a>
            </li>
          ))}
        </ul>
        <a href={s.href}
           class="inline-block mt-4 font-mono text-[12px] uppercase text-accent no-underline hover:underline"
           style="letter-spacing: 0.12em">all {s.label.toLowerCase()} →</a>
      </section>
    ))}
  </section>
</BaseLayout>
