---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupHeader from '../../components/GroupHeader.astro';
import dashboards from '../../data/dashboards.json';
import { pages, siteName } from '../../data/site';

type Status = 'built' | 'in-progress' | 'planned';
type Dashboard = { slug: string; title: string; desc: string; status: Status };

const all = dashboards as Dashboard[];
// Built dashboards carry no label — they're just the list. Everything else
// collapses into one "In progress / planned" group below.
const built = all.filter(d => d.status === 'built');
const upcoming = all.filter(d => d.status !== 'built');
---

<BaseLayout title={`${pages.dashboards.title} — ${siteName}`} description={pages.dashboards.blurb}>
  <section class="max-w-[760px] mx-auto px-8 pt-14 pb-24">
    <h1 class="font-display font-semibold text-[48px] leading-none m-0 mb-3 text-ink"
        style="letter-spacing: -0.03em">{pages.dashboards.title}</h1>
    <p class="font-serif text-[17px] text-muted leading-[1.55] max-w-[580px] m-0 mb-12">{pages.dashboards.blurb}</p>

    <div class="mb-14">
      {built.map((d, i) => (
        <article class:list={['py-5', i < built.length - 1 ? 'border-b border-rule-soft' : '']}>
          <h3 class="font-display font-semibold text-[22px] m-0 mb-1.5 text-ink"
              style="letter-spacing: -0.015em">
            <a href={`/dashboards/${d.slug}`}
               class="text-ink no-underline hover:text-accent transition-colors">
              {d.title}
            </a>
          </h3>
          <p class="font-serif text-[15px] text-ink-soft leading-[1.55] m-0"
             style="text-wrap: pretty">{d.desc}</p>
        </article>
      ))}
    </div>

    {upcoming.length > 0 && (
      <section>
        <GroupHeader label={pages.dashboards.upcomingGroup} count={upcoming.length} />
        {upcoming.map((d, i) => (
          <article class:list={[
            'py-5 opacity-70',
            i < upcoming.length - 1 ? 'border-b border-rule-soft' : '',
          ]}>
            <h3 class="font-display font-semibold text-[22px] m-0 mb-1.5 text-ink"
                style="letter-spacing: -0.015em">{d.title}</h3>
            <p class="font-serif text-[15px] text-ink-soft leading-[1.55] m-0"
               style="text-wrap: pretty">{d.desc}</p>
          </article>
        ))}
      </section>
    )}
  </section>
</BaseLayout>
