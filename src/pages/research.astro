---
import BaseLayout from '../layouts/BaseLayout.astro';
import GroupHeader from '../components/GroupHeader.astro';
import DownloadMd from '../components/DownloadMd.astro';
import { getCollection } from 'astro:content';
import bio from '../data/bio.json';
import presentations from '../data/presentations.json';

const all = await getCollection('research');
const byDate = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const groups = [
  {
    label: 'Publications',
    items: all.filter(r => ['published', 'contribution'].includes(r.data.status)).sort(byDate),
  },
  {
    label: 'In progress / planned',
    items: all.filter(r => ['in-progress', 'upcoming'].includes(r.data.status)).sort(byDate),
  },
].filter(g => g.items.length > 0);
---

<BaseLayout title="Research — Teddy Wright" description="AI governance research.">
  <section class="max-w-[760px] mx-auto px-8 pt-14 pb-24">
    <h1 class="font-display font-semibold text-[48px] leading-none m-0 mb-3 text-ink"
        style="letter-spacing: -0.03em">Research</h1>
    <p class="font-serif text-[17px] text-muted leading-[1.55] max-w-[580px] m-0 mb-12">
      {bio.credentials}
    </p>

    <DownloadMd href="/research.md" label="download all research (.md)" />

    {groups.map(g => (
      <section class="mb-14">
        <GroupHeader label={g.label} count={g.items.length} />
        {g.items.map((r, i) => (
          <article class:list={[
            'py-4',
            i < g.items.length - 1 ? 'border-b border-rule-soft' : '',
          ]}>
            <h3 class="font-display font-semibold text-[20px] m-0 mb-1 text-ink leading-[1.25]"
                style="letter-spacing: -0.015em; text-wrap: balance">
              <a href={`/research/${r.slug}`}
                 class="text-ink no-underline hover:text-accent transition-colors">
                {r.data.title}
              </a>
            </h3>
            <p class="font-serif text-[15px] text-ink-soft leading-[1.55] m-0"
               style="text-wrap: pretty">{r.data.description}</p>
            {(r.data.paperUrl || r.data.externalUrl) && (
              <div class="mt-2 flex gap-4 flex-wrap font-mono text-[12px] uppercase"
                   style="letter-spacing: 0.1em">
                {r.data.paperUrl && (
                  <a href={r.data.paperUrl} target="_blank" rel="noopener"
                     class="text-accent no-underline hover:underline">read paper →</a>
                )}
                {r.data.externalUrl && (
                  <a href={r.data.externalUrl} target="_blank" rel="noopener"
                     class="text-accent no-underline hover:underline">external ↗</a>
                )}
              </div>
            )}
          </article>
        ))}
      </section>
    ))}

    <section>
      <GroupHeader label="Talks & posters" count={presentations.length} />
      <ul class="list-none p-0 m-0">
        {presentations.map((p: any, i: number) => (
          <li class:list={['py-3', i > 0 ? 'border-t border-rule-soft' : '']}>
            <p class="font-serif text-[14px] text-ink-soft leading-[1.5] m-0"
               style="text-wrap: pretty">{p.citation}</p>
            <p class="font-mono text-[11px] text-muted m-0 mt-1" style="letter-spacing: 0.04em">
              {p.url ? (
                <a href={p.url} target="_blank" rel="noopener"
                   class="text-muted no-underline hover:text-accent transition-colors">{p.venue} ↗</a>
              ) : p.venue}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </section>
</BaseLayout>
