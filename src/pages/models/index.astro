---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupHeader from '../../components/GroupHeader.astro';
import { getCollection } from 'astro:content';
import { pages, siteName } from '../../data/site';

const all = await getCollection('models');

// One group. No model is finished — `published` means it has a real page and a
// dashboard but the work is ongoing, `draft` means stub only — so splitting them
// into separate headings drew a line that wasn't there. Published sort first and
// are linked; drafts render dimmed and unlinked, which carries the distinction.
const items = all.sort((a, b) => {
  const liveDelta = Number(b.data.status === 'published') - Number(a.data.status === 'published');
  if (liveDelta !== 0) return liveDelta;
  const featuredDelta = Number(b.data.featured) - Number(a.data.featured);
  if (featuredDelta !== 0) return featuredDelta;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout title={`${pages.models.title} — ${siteName}`} description={pages.models.blurb}>
  <section class="max-w-[760px] mx-auto px-8 pt-14 pb-24">
    <h1 class="font-display font-semibold text-[48px] leading-none m-0 mb-3 text-ink"
        style="letter-spacing: -0.03em">{pages.models.title}</h1>
    <p class="font-serif text-[17px] text-muted leading-[1.55] max-w-[580px] m-0 mb-14">{pages.models.blurb}</p>

    {items.length === 0 ? (
      <div class="text-center py-16 font-serif italic text-muted">
        <p>No models yet.</p>
      </div>
    ) : (
      <section class="mb-14">
        <GroupHeader label={pages.models.group} count={items.length} />
        {items.map((m, i) => {
          const live = m.data.status === 'published';
          return (
            <article class:list={[
              'py-5',
              i < items.length - 1 ? 'border-b border-rule-soft' : '',
              live ? '' : 'opacity-70',
            ]}>
              <h3 class="font-display font-semibold text-[22px] m-0 mb-1.5 text-ink"
                  style="letter-spacing: -0.015em">
                {live ? (
                  <a href={`/models/${m.slug}`}
                     class="text-ink no-underline hover:text-accent transition-colors">
                    {m.data.title}
                  </a>
                ) : (
                  m.data.title
                )}
              </h3>
              <p class="font-serif text-[15px] text-ink-soft leading-[1.55] m-0"
                 style="text-wrap: pretty">{m.data.description}</p>
            </article>
          );
        })}
      </section>
    )}
  </section>
</BaseLayout>
